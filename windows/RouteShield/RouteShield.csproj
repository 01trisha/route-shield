<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>RouteShield.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0-beta.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RouteShield.Tests" />
    <EmbeddedResource Include="CountryNames.json" />
    <EmbeddedResource Include="../../RELEASE_NOTES.md" LogicalName="RouteShield.ReleaseNotes.md" />
  </ItemGroup>
</Project>
